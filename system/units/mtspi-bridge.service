[Unit]
Description=MTS Pi: home screen on the dashboard (mySPIN), CarPlay and the Bluetooth bridge iPhone -> bike
# does not wait for mtspi-adapters (slow reconnections): radio names and classes arrive in parallel
After=bluetooth.service ofono.service user@@UID@.service
Wants=user@@UID@.service
# if bluetoothd restarts, profiles and the pairing agent must be registered again
PartOf=bluetooth.service

[Service]
User=@USER@
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@UID@/bus
# settings: edit /etc/default/mtspi, then  sudo systemctl restart mtspi-bridge
EnvironmentFile=-/etc/default/mtspi
ExecStart=@REPO@/system/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
