[Unit]
Description=MTS Pi: home screen on the dashboard (mySPIN), CarPlay and the Bluetooth bridge iPhone -> bike
# does not wait for mtspi-adapters (slow reconnections): radio names and classes arrive in parallel
# The user session (its bus is needed later, for the phonebook) is wanted but not waited for: waiting for it held the
# start back by about ten seconds (17 Nov 2026). The hands-free service, which plays the music, still waits for it.
After=bluetooth.service ofono.service
Wants=user@@UID@.service
# if bluetoothd restarts, profiles and the pairing agent must be registered again
PartOf=bluetooth.service

[Service]
User=@USER@
Environment=XDG_RUNTIME_DIR=/run/user/@UID@
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/@UID@/bus
# settings: edit /etc/default/mtspi, then  sudo systemctl restart mtspi-bridge
EnvironmentFile=-/etc/default/mtspi
# where the logs go on the protected card (written at every start by mtspi-logs); absent elsewhere
EnvironmentFile=-/run/mtspi-logs.env
ExecStart=@REPO@/system/run.sh
# the program says "alive" every few seconds. This long time covers its start; once running it asks systemd for
# 30 s itself (mtspi/alive.py): silent for that long = stuck, systemd ends it and starts it again
WatchdogSec=120
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
