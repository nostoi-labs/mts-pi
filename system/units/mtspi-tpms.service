[Unit]
Description=MTS Pi: listens for tyre pressure sensors (Bluetooth LE, never connects). Experimental, off unless asked for
After=bluetooth.service mtspi-adapters.service mtspi-logs.service mtspi-setup.service

[Service]
User=@USER@
# asking the radio to scan needs these two; nothing else runs as root
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN
# TPMS=1 switches it on (TPMS=on in mtspi.txt). Optional: TPMS_WINDOW_MS, TPMS_INTERVAL_MS, TPMS_ON_S, TPMS_OFF_S,
# TPMS_FRONT, TPMS_REAR
EnvironmentFile=-/etc/default/mtspi
EnvironmentFile=-/run/mtspi-logs.env
ExecCondition=/bin/sh -c '[ "${TPMS:-0}" = 1 ]'
ExecStart=/usr/bin/python3 @REPO@/mtspi/tpms.py
Nice=10
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
